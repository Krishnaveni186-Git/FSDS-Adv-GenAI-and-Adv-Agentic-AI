import numpy as np
import matplotlib.pyplot as plt
import pandas as pd

dataset = pd.read_csv(r'C:\Users\user\FSDS_Adv_Gene_AI_&Agentic_AI\Machine Learning\Data Preprocessing\salary_data.csv')


# Createing x and Y variables
x = dataset.iloc[:, : -1]
y = dataset.iloc[:, -1]


# Delacre the test and accuracy % (80%-20%)
from sklearn.model_selection import train_test_split
x_train,x_test, y_train, y_test = train_test_split(x,y, test_size = 0.20, random_state = 0)


# Training the model
from sklearn.linear_model import LinearRegression
model = LinearRegression()
model.fit(x_train,y_train)

# Predicting the result for the test set
y_pred = model.predict(x_test)

# Visualization of Linearregression
plt.scatter(x_test,y_test, color = 'red')
plt.plot(x_train, model.predict(x_train), color ='blue')
plt.title('Salary vs Experience (Test set)')
plt.xlabel('Years of Experience')
plt.ylabel('Salary')
plt.show()

# Checking the Model Coeffiecent
m_coef = model.coef_
print(m_coef)

c_intercept = model.intercept_
print(c_intercept)

# Predicting the no of experience (12 years)
y_12 = m_coef * 12 + c_intercept
print(y_12)

# Predicting the no of experience (20 years)
y_20 = m_coef *20 +c_intercept
print(y_20)

bias_score  = model.score(x_train, y_train)
print(bias_score)

variance_score = model.score(x_test, y_test)
print(variance_score)

